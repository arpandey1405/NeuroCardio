# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# ---------------------------------------------------------------- Node / Next.js
# (frontend/.gitignore covers the Next.js specifics)
node_modules/
.next/
*.tsbuildinfo
npm-debug.log*

# ---------------------------------------------------------------- Secrets / local config
.env
.env.*
!.env.example
.claude/
.vscode/
.idea/

# ---------------------------------------------------------------- Runtime data
# Recorded sessions can contain a real person's ECG features - keep them private.
host/session_*.csv

# Regenerated by `python host/train_model.py` (and pickles aren't safe to share)
host/models/*.joblib

# ---------------------------------------------------------------- Datasets & training outputs
# MIT-BIH is downloaded by the notebook; don't commit raw records
mitdb/
**/mit-bih-arrhythmia-database*/
*.zip
*.dat
*.hea
*.atr
notebook/neurocardio_*.csv
# the trained SNN (host/models/neurocardio_snn.pt) IS meant to be committed

# ---------------------------------------------------------------- Arduino build output
firmware/**/build/
*.elf
*.hex

# ---------------------------------------------------------------- OS / editor clutter
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
~$*
